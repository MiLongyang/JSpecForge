# ===== JSpecForge 实验产物与依赖入库 =====
# 实验产物目录（314MB sql/jsonl 结果不入库，仅保留 .gitkeep 占位）
a/

# 覆盖上方 Python 通用规则中的 lib/: 本项目 lib/ 是 OpenJML/major/jqwik 等
# 运行时依赖（jar），必须入库，而非当作构建产物。
!lib/
!lib/**
# lib/ 内部自带的运行日志（如 major 的 mmlc.log）仍不入库
lib/**/*.log
# 动态黑名单持久化文件（运行期生成，不入库）
dynamic_blacklist.json
